# ==============================================================================
# 🚀 SITE MONITOR SERVICE - ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# COPY THIS FILE TO '.env' AND FILL IN YOUR SECURE ENVIRONMENT VALUES.
# DO NOT COMMIT SENSITIVE SECRETS TO GIT REPOSITORIES.
# ==============================================================================

# ------------------------------------------------------------------------------
# 🌐 1. APPLICATION CORE SETTINGS
# ------------------------------------------------------------------------------
APP_ENV=production
APP_NAME="Site Monitor Service"
APP_VERSION="1.0.0"
DEBUG=false
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ------------------------------------------------------------------------------
# 🔒 2. SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
SECRET_KEY=generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 🗄️ 3. DATABASE CONFIGURATION (PostgreSQL + AsyncPG)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=site_monitor

DATABASE_URL=postgresql+asyncpg://postgres:your_secure_db_password@db:5432/site_monitor

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# ------------------------------------------------------------------------------
# ⚡ 4. REDIS CACHE & TASK QUEUE
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0
REDIS_URL=redis://:your_redis_password@redis:6379/0

# ------------------------------------------------------------------------------
# 🛡️ 5. SECURITY, CORS & RATE LIMITING
# ------------------------------------------------------------------------------
CORS_ORIGINS=https://yourdomain.com
ALLOWED_HOSTS=yourdomain.com,localhost,127.0.0.1
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20

# ------------------------------------------------------------------------------
# 📡 6. SITE MONITORING WORKER ENGINE
# ------------------------------------------------------------------------------
MONITORING_CHECK_INTERVAL_SECONDS=60
DEFAULT_HTTP_TIMEOUT_SECONDS=10
MAX_CONCURRENT_CHECKS=50
MONITORING_USER_AGENT="Mozilla/5.0 (compatible; SiteMonitorBot/1.0; +https://yourdomain.com/bot)"

# ------------------------------------------------------------------------------
# 🔔 7. ALERTING & NOTIFICATION INTEGRATIONS
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=alerts@yourdomain.com
SMTP_TLS=true

# ------------------------------------------------------------------------------
# 📊 8. OBSERVABILITY, LOGGING & TELEMETRY
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON_FORMAT=true
SENTRY_DSN=https://your_sentry_dsn@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
PROMETHEUS_METRICS_ENABLED=true
